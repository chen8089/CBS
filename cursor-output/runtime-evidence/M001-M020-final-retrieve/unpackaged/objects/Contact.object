<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Employment_Status__c</fullName>
        <label>Employment status</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Existing Hire</fullName>
                    <default>false</default>
                    <label>Existing Hire</label>
                </value>
                <value>
                    <fullName>Pre-hire</fullName>
                    <default>false</default>
                    <label>Pre-hire</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Full_Name__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>全名</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ID_Number__c</fullName>
        <encryptionScheme>None</encryptionScheme>
        <externalId>false</externalId>
        <label>证件号码</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ID_Type__c</fullName>
        <label>证件类型</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>NRIC</fullName>
                    <default>false</default>
                    <label>NRIC</label>
                </value>
                <value>
                    <fullName>FIN</fullName>
                    <default>false</default>
                    <label>FIN</label>
                </value>
                <value>
                    <fullName>Passport</fullName>
                    <default>false</default>
                    <label>Passport</label>
                </value>
                <value>
                    <fullName>Other</fullName>
                    <default>false</default>
                    <label>Other</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <validationRules>
        <fullName>CBS_DS_Required_Identity_By_Stage</fullName>
        <active>true</active>
        <description>Requires Data Subject identity fields only during active processing stages.</description>
        <errorConditionFormula>AND(
    $RecordType.DeveloperName = &quot;Data_Subject&quot;,
    OR(
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Upload&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Consent Request&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Active Consent&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Processing&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Report Request&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Report Fulfilment&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Departure&quot;)
    ),
    OR(
        ISBLANK(AccountId),
        ISBLANK(Full_Name__c),
        ISBLANK(Email),
        ISBLANK(TEXT(ID_Type__c)),
        ISBLANK(ID_Number__c),
        ISBLANK(Date_of_Birth__c),
        ISBLANK(TEXT(Employment_Status__c))
    )
)</errorConditionFormula>
        <errorMessage>Complete the required Data Subject identity fields before continuing this active processing stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CBS_NSP_Required_Identity_By_Stage</fullName>
        <active>true</active>
        <description>Requires Non-Singpass identity fields during active processing and Non-Singpass authentication from Consent Request onward.</description>
        <errorConditionFormula>AND(
    $RecordType.DeveloperName = &quot;Non_Singpass&quot;,
    OR(
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Upload&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Consent Request&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Active Consent&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Processing&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Report Request&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Report Fulfilment&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Departure&quot;)
    ),
    OR(
        ISBLANK(AccountId),
        ISBLANK(Full_Name__c),
        ISBLANK(Email),
        ISBLANK(TEXT(ID_Type__c)),
        ISBLANK(ID_Number__c),
        ISBLANK(Date_of_Birth__c),
        ISBLANK(TEXT(Employment_Status__c)),
        AND(
            NOT(ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Upload&quot;)),
            NOT(ISPICKVAL(Authentication_Type__c, &quot;Non-Singpass&quot;))
        )
    )
)</errorConditionFormula>
        <errorMessage>Complete the required Non-Singpass identity and authentication fields before continuing this active processing stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CBS_SP_Required_Identity_By_Stage</fullName>
        <active>true</active>
        <description>Requires Singpass identity fields during active processing and Singpass authentication from Consent Request onward.</description>
        <errorConditionFormula>AND(
    $RecordType.DeveloperName = &quot;Singpass&quot;,
    OR(
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Upload&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Consent Request&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Active Consent&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Processing&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Report Request&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Report Fulfilment&quot;),
        ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Departure&quot;)
    ),
    OR(
        ISBLANK(AccountId),
        ISBLANK(Full_Name__c),
        ISBLANK(Email),
        ISBLANK(TEXT(ID_Type__c)),
        ISBLANK(ID_Number__c),
        ISBLANK(Date_of_Birth__c),
        ISBLANK(TEXT(Employment_Status__c)),
        AND(
            NOT(ISPICKVAL(Data_Subject_Lifecycle_Stage__c, &quot;Upload&quot;)),
            NOT(ISPICKVAL(Authentication_Type__c, &quot;Singpass&quot;))
        )
    )
)</errorConditionFormula>
        <errorMessage>Complete the required Singpass identity and authentication fields before continuing this active processing stage.</errorMessage>
    </validationRules>
</CustomObject>
