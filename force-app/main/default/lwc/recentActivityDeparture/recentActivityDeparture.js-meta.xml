    <isExposed>true</isExposed>
    <masterLabel>Departure Recent Activity</masterLabel>
    <description>Recent Departure activity feed for Experience Cloud and Lightning pages.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__AppPage</target>
