<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Contact Current Record Tracking</masterLabel>
    <description>Shows tracked field changes for current Contact record only.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default,lightning__RecordPage">
            <property name="contactId" type="String" label="Contact Id (Optional Override)" />
            <property name="maxItems" type="Integer" label="Max Items" default="20" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>