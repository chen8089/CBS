<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>CBS Home Landing Section</masterLabel>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default,lightning__AppPage,lightning__HomePage">
            <property
                name="bannerTitle"
                type="String"
                label="Banner Title"
                description="Banner heading text"
                default="Credit Bureau Singapore"
            />
            <property
                name="bannerDescription"
                type="String"
                label="Banner Description"
                description="Banner supporting description"
                default="Empowering better credit decisions with trusted data and insights."
            />
            <property
                name="buttonLabel"
                type="String"
                label="Button Label"
                description="Primary banner button text"
                default="Learn More"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>