<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Contact Us Breadcrumb</masterLabel>
    <description>Static breadcrumb for Contact Us Experience Cloud page.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default,lightning__AppPage,lightning__RecordPage">
            <property name="homeLabel" type="String" label="Home Label" default="HOME"/>
            <property name="currentLabel" type="String" label="Current Page Label" default="CONTACT US"/>
            <property name="homeUrl" type="String" label="Home URL" default="/"/>
            <property name="homePageName" type="String" label="Home Named Page API Name" default="Home"/>
            <property name="headerTitle" type="String" label="Header Title" default="Partner Community"/>
            <property name="officialSiteUrl" type="String" label="Official Site URL" default="https://www.creditbureau.com.sg/"/>
            <property name="contactEmail" type="String" label="Contact Email" default="consumer_services@creditbureau.com.sg"/>
            <property name="supportHotline" type="String" label="Support Hotline" default="+65 6565 6363"/>
            <property name="showQuickActions" type="Boolean" label="Show Utility Links" default="true"/>
            <property name="maxWidth" type="String" label="Max Width" default="1280px"/>
            <property name="topSpacing" type="String" label="Top Spacing" default="24px"/>
            <property name="bottomSpacing" type="String" label="Bottom Spacing" default="24px"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>