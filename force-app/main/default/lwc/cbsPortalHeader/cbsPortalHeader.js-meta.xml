<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>CBS Portal Header</masterLabel>
    <description>CBS branded header for authenticated Experience Cloud pages.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__AppPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default,lightning__AppPage">
            <property name="logoUrl" type="String" label="Logo URL" description="Optional logo URL. Leave blank to use cbsLogo static resource." />
            <property name="homeUrl" type="String" label="Home URL" default="/s/" />
            <property name="officialSiteUrl" type="String" label="Official Site URL" default="https://www.creditbureau.com.sg" />
            <property name="showStickyHeader" type="Boolean" label="Sticky Header" default="true" />
            <property name="showUserMenu" type="Boolean" label="Show User Menu" default="true" />
            <property name="logoutUrl" type="String" label="Logout URL" default="/secur/logout.jsp" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>