<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Return_Created_Request</name>
        <label>Return Created Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>resolvedRequestItemId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_New_Request.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Return_Existing_Request</name>
        <label>Return Existing Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>resolvedRequestItemId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Find_Active_Request.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Active_Request_Found</name>
        <label>Active Request Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_New_Request</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Create New Cycle</defaultConnectorLabel>
        <rules>
            <name>Reuse_Existing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_Active_Request</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Return_Existing_Request</targetReference>
            </connector>
            <label>Reuse Existing</label>
        </rules>
    </decisions>
    <description>Returns an existing Pending, Sent or Viewed consent request for the same Data Subject and purpose, or creates a new Pending request. Communication resend remains owned by Category F.</description>
    <environments>Default</environments>
    <formulas>
        <name>ComputedActiveRequestKey</name>
        <dataType>String</dataType>
        <expression>CASESAFEID({!contactRecord.Id}) &amp; &quot;|&quot; &amp; CASESAFEID({!contactRecord.AccountId}) &amp; &quot;|&quot; &amp; TEXT({!contactRecord.Consent_Type__c})</expression>
    </formulas>
    <formulas>
        <name>SanitisedFaultDescription</name>
        <dataType>String</dataType>
        <expression>&quot;Flow ConsentRequestResolveActiveRequest failed for Contact &quot; &amp; {!contactRecord.Id} &amp; &quot;. No identity, date of birth or MyInfo value is included.&quot;</expression>
    </formulas>
    <interviewLabel>Resolve Active Consent Request {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Consent Request Resolve Active Request</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Fault_Case</name>
        <label>Create Sanitised Fault Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>contactRecord.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>contactRecord.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>SanitisedFaultDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Exception_Type__c</field>
            <value>
                <stringValue>Other</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_Processing_Queue.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>A-IMP-02 consent request creation failure</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <stringValue>Problem</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_New_Request</name>
        <label>Create New Pending Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Return_Created_Request</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Get_Processing_Queue</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Consent_Purpose__c</field>
            <value>
                <elementReference>contactRecord.Consent_Type__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Current_Status__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Data_Subject__c</field>
            <value>
                <elementReference>contactRecord.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Uploaded_Date_of_Birth__c</field>
            <value>
                <elementReference>contactRecord.Date_of_Birth__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Uploaded_Email__c</field>
            <value>
                <elementReference>contactRecord.Email</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Uploaded_Employment_Status__c</field>
            <value>
                <elementReference>contactRecord.Employment_Status__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Uploaded_Full_Name__c</field>
            <value>
                <elementReference>contactRecord.Full_Name__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Uploaded_ID_Number__c</field>
            <value>
                <elementReference>contactRecord.ID_Number__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Uploaded_ID_Type__c</field>
            <value>
                <elementReference>contactRecord.ID_Type__c</elementReference>
            </value>
        </inputAssignments>
        <object>Consent_Request_Item__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Find_Active_Request</name>
        <label>Find Active Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Active_Request_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Get_Processing_Queue</targetReference>
        </faultConnector>
        <filterLogic>1 AND (2 OR 3 OR 4)</filterLogic>
        <filters>
            <field>Active_Request_Key__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>ComputedActiveRequestKey</elementReference>
            </value>
        </filters>
        <filters>
            <field>Current_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </filters>
        <filters>
            <field>Current_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Sent</stringValue>
            </value>
        </filters>
        <filters>
            <field>Current_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Viewed</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Consent_Request_Item__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Processing_Queue</name>
        <label>Get Processing Queue</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Fault_Case</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>CBS_Processing_Queue</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Find_Active_Request</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>contactRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>resolvedRequestItemId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
